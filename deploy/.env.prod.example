# Prod values for the transigen-env Kubernetes Secret. Copy to deploy/.env.prod
# on the server (gitignored, chmod 600), fill in real values, then deploy.sh
# turns it into the Secret on every deploy (kubectl create secret
# --from-env-file). Real secrets live only in that gitignored file; no Secret
# YAML exists anywhere.

# PostgreSQL connection string. The shared Postgres in the `data` namespace,
# reached in-cluster as the least-privilege transigen_rw role. The password must
# match the TRANSIGEN_DB_PASSWORD used when provisioning (deploy/provision-db.sh).
DATABASE_URL=postgres://transigen_rw:replace-with-transigen-db-password@postgres.data.svc.cluster.local:5432/transigen

# --- Auth.js (Google OAuth) ---
# Session-cookie signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  https://transigen.lans-h.cc/api/auth/callback/google
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
# Canonical public URL (must match the Ingress host) + trust Traefik's forwarded
# host header. Both are required in production behind the reverse proxy; local
# dev needs neither.
AUTH_URL=https://transigen.lans-h.cc
AUTH_TRUST_HOST=true

# --- YouTube Data API v3 (server-only, optional) ---
# Used to fetch reliable video metadata (title, channel, duration).
YOUTUBE_API_KEY=

# --- Spotify Web API (server-only, optional, Client Credentials flow) ---
# Used to look up track BPM from a sanitized YouTube title.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
