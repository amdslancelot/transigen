# Staging template for the transigen-env Secret. These are LOCAL-ONLY dev/test
# defaults (staging runs on a developer's minikube, never on the public
# internet), so this .example is committed. stage.sh reads deploy/.env.staging
# if you create one, otherwise it falls back to this committed template — so a
# fresh clone spins up staging out of the box.
#
# For real Google sign-in on staging, `cp .env.staging.example .env.staging`
# and put a real OAuth client in the copy (`.env.staging` is gitignored, so the
# client secret is never committed). Add
# http://transigen.staging.localhost/api/auth/callback/google as an authorized
# redirect URI in the Google Cloud console.

# Shared Postgres in the `data` namespace (cross-namespace DNS). The
# transigen_rw password must match the TRANSIGEN_DB_PASSWORD that stage.sh
# passes to provision-db.sh (staging convention: the literal "transigen").
DATABASE_URL=postgres://transigen_rw:transigen@postgres.data.svc.cluster.local:5432/transigen

# Auth.js session/JWT signing secret (dev-only value).
AUTH_SECRET=staging-dev-secret-not-for-production

# Google OAuth client. Replace to exercise real sign-in on staging.
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# Canonical URL Auth.js uses to build callback URLs on staging.
AUTH_URL=http://transigen.staging.localhost
AUTH_TRUST_HOST=true

# Optional integrations; the app works without them.
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
